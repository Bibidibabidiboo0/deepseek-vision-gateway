# 复制为 .env 后填写真实值（.env 已被 gitignore，不会入库）

# 网关监听端口（默认 8787，Claude Code 的 ANTHROPIC_BASE_URL 指向它）
PORT=8787

# DeepSeek 文本端点（Anthropic 兼容格式）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# 智谱视觉端点（GLM-4V-Flash 免费）
VISION_API_KEY=你的智谱API密钥
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4v-flash
# VISION_MODE=glm   # glm | mineru（mineru 本地 OCR 路由待实现）

# 发给 GLM 的历史裁剪（glm-4v-flash 上下文小）
MAX_KEEP_TURNS=8
MAX_CTX_CHARS=16000
